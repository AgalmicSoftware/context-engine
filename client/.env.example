# Context Engine public client config
# Copy to client/.env only when you need to override the built-in defaults.
# The Vite client compatibility layer exposes only REACT_APP_* vars to the browser.

# =========================
# Required
# =========================

# None. General local dev works without client/.env.
# Production release builds set the reviewed public replay commit for native
# Cloudflare deployment. Helper and healthcheck URLs are optional fallbacks.


# =========================
# Optional/Deployment
# =========================

# Shared/default sessionCorsWorker URL used when no session-specific worker URL is available.
# Leave blank unless you intentionally operate or rely on a known shared worker.
# REACT_APP_CE_SHARED_WORKER_URL=https://<worker-name>.<account-subdomain>.workers.dev/

# Exact immutable public replay commit containing deploy/cloudflare/session-worker/.
# Required in a release that enables the native deployment card.
# REACT_APP_CE_CLOUDFLARE_NATIVE_DEPLOY_REPLAY_COMMIT=0123456789abcdef0123456789abcdef01234567

# Legacy deploy-helper URL used by Session Wizard / Sponsor fallback flows.
# Defaults to the project helper `https://ce-deploy-helper.agalmic.workers.dev/`.
# Override this only when you self-host or intentionally point at another helper.
# Bootstrap options for your own helper: `npm run deploy-helper:deploy` or the example files under `workers/deploy-helper/`.
# REACT_APP_CE_DEPLOY_HELPER_URL=https://<deploy-helper-name>.<account-subdomain>.workers.dev/

# Healthcheck worker URL used by worker diagnostics.
# In the current OSS flow, set this yourself for hosted/onchain bring-your-own-worker runs.
# REACT_APP_CE_HEALTHCHECK_WORKER_URL=https://<healthcheck-worker-name>.<account-subdomain>.workers.dev/

# Hosted worker bundle URL for deploy-helper and manual bundle fetch flows.
# REACT_APP_CE_WORKER_BUNDLE_URL=https://github.com/AgalmicSoftware/context-engine/releases/latest/download/sessionCorsWorker.bundle.js
# REACT_APP_CE_WORKER_RELEASE_MANIFEST_URL=https://github.com/AgalmicSoftware/context-engine/releases/latest/download/worker-release-manifest.json

# Backend/API base URL used by the SPA where legacy server calls still exist.
# REACT_APP_SERVER=http://localhost:5000

# Preferred Arweave gateway base used for user-facing links and normalized tx URLs.
# REACT_APP_ARWEAVE_GATEWAY_URL=https://ar-io.dev

# Ar.io gateway base used when direct-to-ar.io mode is enabled.
# REACT_APP_CE_ARWEAVE_AR_IO_URL=https://ar-io.dev

# Canonical default chain id for wallet/network fallbacks across the app.
# REACT_APP_DEFAULT_CHAIN_ID=11155420
# Base Sepolia compatibility-verification target. This is not usable for
# chain-backed CE flows until canonical 84532 contract addresses are restored.
# REACT_APP_DEFAULT_CHAIN_ID=84532

# UI threshold for login-stage auto-funding requests.
# REACT_APP_TESTNET_AUTO_SEND_THRESHOLD_ETH=0.001

# Canonical default session slug kept in client state/config.
# Leave blank to preserve the general-session default behavior.
# REACT_APP_DEFAULT_SESSION_SLUG=

# Alias used in URLs/on-chain flows when the canonical slug is empty.
# REACT_APP_DEFAULT_SESSION_SLUG_ALIAS=general

# Bundled visual theme used when a user has no explicit local preference.
# Supported values: context-engine, classic-95
# REACT_APP_CE_DEFAULT_THEME=context-engine

# End-user Settings selector (enabled by default). Set false only when a
# deployment intentionally hides bundled app-theme selection.
# REACT_APP_CE_THEME_SELECTOR_ENABLED=true

# Default session scan scope (all|active|general|list).
# REACT_APP_CE_SESSION_SCAN_SCOPE=list

# Default session scan slug list. Use CSV or a JSON array. Use "general" for the default session.
# REACT_APP_CE_SESSION_SCAN_SLUGS=demo

# Profile deep-scan defaults for cross-session fanout.
# Leave these false to keep list-scoped profile scans on the selected session list only.
# REACT_APP_CE_USER_PROFILE_SCAN_ALL_SESSIONS=false
# REACT_APP_CE_USER_PROFILE_SCAN_ALL_SESSIONS_SBTS=false
# REACT_APP_CE_USER_PROFILE_SCAN_ALL_SESSIONS_SURVEYS=false
# REACT_APP_CE_USER_PROFILE_SCAN_ALL_SESSIONS_QUESTIONS=false

# Profile deep-scan worker tuning (integers, in ms where noted).
# REACT_APP_CE_PROFILE_SCAN_SBT_BURST_SIZE=4
# REACT_APP_CE_PROFILE_SCAN_SBT_TIMEOUT_MS=30000
# REACT_APP_CE_PROFILE_SCAN_ACTIVITY_TIMEOUT_MS=12000
# REACT_APP_CE_PROFILE_SCAN_REGISTRY_TIMEOUT_MS=45000

# RPC read tuning and listener guardrails.
# REACT_APP_MAX_SBT_INSTANCE_LISTENERS=25
# REACT_APP_SBT_INSTANCE_LISTENER_GROUPS=general
# REACT_APP_CE_GETLOGS_MAX_CONCURRENCY=1
# REACT_APP_CE_GETLOGS_MAX_RETRIES=2
# REACT_APP_CE_SBT_SYNC_BAR_RESEARCH_BLOCK_STEP=50

# Demo data autoload slugs for PolisReport fixtures. Use CSV or a JSON array.
# REACT_APP_POLIS_DEMO_DATA_AUTOLOAD_SLUGS=demo


# =========================
# Feature Toggles
# =========================

# Auto-request testnet funds on login when wallet balance is low.
# REACT_APP_DEFAULT_AUTO_REQUEST_TESTNET_FUNDS=true

# Passkey EOA wallet config. `NEXT_PUBLIC_*` is supported directly; the
# `REACT_APP_NEXT_PUBLIC_*` aliases are kept for older CE deploy tooling.
# RP ID is the WebAuthn relying-party domain and should usually be the parent
# domain of the app/account origins, for example `example.com`.
# Local loopback development may use `localhost`.
# NEXT_PUBLIC_RP_ID=localhost
# NEXT_PUBLIC_RP_NAME="Context Engine"
# NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
# NEXT_PUBLIC_ACCOUNT_ORIGIN=http://localhost:3000
# NEXT_PUBLIC_WALLET_MODE=passkey-eoa
# NEXT_PUBLIC_WALLET_KEY_MODE=passkey-derived
# NEXT_PUBLIC_WALLET_DERIVATION_NAMESPACE=context-engine
# NEXT_PUBLIC_SESSION_MODE=soft
# NEXT_PUBLIC_WALLET_UNLOCK_TTL_SECONDS=900
# NEXT_PUBLIC_ALLOW_PREVIEW_RP_ID=false
# REACT_APP_NEXT_PUBLIC_RP_ID=localhost
# REACT_APP_NEXT_PUBLIC_RP_NAME="Context Engine"
# REACT_APP_NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
# REACT_APP_NEXT_PUBLIC_ACCOUNT_ORIGIN=http://localhost:3000
# REACT_APP_NEXT_PUBLIC_WALLET_KEY_MODE=passkey-derived
# REACT_APP_NEXT_PUBLIC_WALLET_DERIVATION_NAMESPACE=context-engine

# Passkey EOA soft-session mode (true = routine message/tx signing can reuse
# the worker-held session while the wallet remains unlocked).
# REACT_APP_PASSKEY_WALLET_SOFT_SESSION_ENABLED=true

# Include the MetaMask connector and RainbowKit login UI in the client build.
# Default false produces the passkey-only profile and omits the MetaMask login button and connector modules.
# REACT_APP_CE_ENABLE_METAMASK_CONNECTOR=false

# Enable RainbowKit's MetaMask WalletConnect fallback when MetaMask is not injected.
# This only applies when REACT_APP_CE_ENABLE_METAMASK_CONNECTOR=true.
# REACT_APP_CE_ENABLE_WALLETCONNECT_FALLBACK=false

# Animate the CE logo on first load before swapping to the static asset.
# REACT_APP_ENABLE_CE_LOGO_ANIMATION=true

# Debug/logging toggles.
# REACT_APP_ENABLE_RPC_DEBUG_LOGGING=false
# REACT_APP_ENABLE_RPC_DEBUG_STATS=false
# REACT_APP_ENABLE_RPC_DEBUG_TRACE=false
# REACT_APP_CE_RPC_VERBOSE_ERRORS=false
# REACT_APP_CE_RPC_LOG_PROVIDER_SUCCESS=false

# RPC/provider selection toggles and modes.
# REACT_APP_PREFER_PATH_RPC=true
# REACT_APP_CE_USE_INFURA_RPC=false
# REACT_APP_CE_RPC_PROVIDER_MODE=fallback
# Paid RPC overrides used only for local/browser diagnostics.
# These values are browser-visible when the app runs, so keep them in uncommitted
# `client/.env` for local testing only. Do not treat them as server-only secrets.
# REACT_APP_CE_BASE_SEPOLIA_PAID_RPC_URL_HTTP=https://base-sepolia.infura.io/v3/<YOUR_KEY>
# REACT_APP_CE_BASE_SEPOLIA_PAID_RPC_URL_WSS=wss://base-sepolia.infura.io/ws/v3/<YOUR_KEY>
# REACT_APP_CE_OP_SEPOLIA_PAID_RPC_URL_HTTP=https://optimism-sepolia.infura.io/v3/<YOUR_KEY>
# REACT_APP_CE_OP_SEPOLIA_PAID_RPC_URL_WSS=wss://optimism-sepolia.infura.io/ws/v3/<YOUR_KEY>

# SBT scan/listener toggles and modes.
# REACT_APP_DISABLE_SBT_INSTANCE_LISTENERS=false
# REACT_APP_ENABLE_SBT_HISTORY_SCAN=false
# REACT_APP_CE_SBT_INSTANCE_LISTENERS_MODE=auto
# REACT_APP_CE_SBT_FULL_SCAN_POLICY=auto
# REACT_APP_CE_SBT_SELECTOR_AUTO_SEARCH_OTHER_SESSIONS=true

# Survey/UI toggles.
# REACT_APP_TERMINOLOGY_MODE=plain
# REACT_APP_ENABLE_IMPORTANCE_SLIDER_TOGGLE=true
# REACT_APP_ENABLE_TARGETED_SBT_METADATA_LOOKUP=true
# REACT_APP_SHOW_DEMO_SESSIONS=false
# First-run default for surface-level demo affordances (demoSurfaceMode).
# Users who toggle demoSurfaceMode keep their stored preference; this only
# applies on fresh installs / cleared localStorage.
# REACT_APP_CE_DEMO_SURFACE_MODE_DEFAULT=true

# Testing and demo-resolution toggles.
# REACT_APP_CE_RPC_TESTING_MODE=false
# REACT_APP_CE_SESSION_SCAN_RESOLVE_DEMO_SESSION_ALIASES=false

# Temporary Lit sponsorship rollout toggle for `/new` while CE is still on the
# Naga-era Lit path. Keep false until the Lit payer-wallet authoring flow is
# intentionally enabled for the Chipotle migration path.
# REACT_APP_ENABLE_LIT_SESSION_PAYER_WALLET_INPUT=false

# Session authority mode toggles.
# REACT_APP_USE_ONCHAIN_SESSION_REGISTRY=true

# Arweave mode toggles.
# REACT_APP_ARWEAVE_ACTIVE=true
# REACT_APP_CE_ARWEAVE_DIRECT_TO_AR_IO=true
# Display-critical metadata categories skip GraphQL tx-existence precheck by default.
# REACT_APP_CE_ARWEAVE_PREFLIGHT_SESSION_METADATA=false
# REACT_APP_CE_ARWEAVE_PREFLIGHT_SBT_METADATA=false
# Response payloads keep the conservative precheck default unless you intentionally disable it.
# REACT_APP_CE_ARWEAVE_PREFLIGHT_RESPONSE_PAYLOADS=true

# Optional profile scan diagnostics.
# REACT_APP_CE_PROFILE_SCAN_COLD_DIAG=false

# Session Wizard bundle/deploy-helper toggles.
# REACT_APP_CE_DEFAULT_EMBEDDED_DEPLOY_HELPER_ENABLED=true
