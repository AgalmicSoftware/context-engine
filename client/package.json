{
  "name": "client",
  "version": "0.2.3",
  "description": "Context Engine — React client for sessions, surveys, and SBT-gated encryption",
  "author": "Context Engine Contributors",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AgalmicSoftware/context-engine"
  },
  "bugs": {
    "url": "https://github.com/AgalmicSoftware/context-engine/issues"
  },
  "homepage": "https://contextengine.sh/",
  "engines": {
    "npm": "^10.0.0",
    "node": "^20.19.0 || >=22.12.0"
  },
  "private": true,
  "dependencies": {
    "@babel/runtime": "7.29.2",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@fortawesome/fontawesome-svg-core": "1.2.28",
    "@fortawesome/free-brands-svg-icons": "5.13.0",
    "@fortawesome/free-solid-svg-icons": "5.13.0",
    "@fortawesome/react-fontawesome": "0.2.6",
    "@metamask/eth-sig-util": "7.0.3",
    "@noble/secp256k1": "2.3.0",
    "@rainbow-me/rainbowkit": "0.8.1",
    "@tanstack/react-query": "4.42.0",
    "arweave": "1.15.7",
    "crypto-js": "4.2.0",
    "d3": "7.9.0",
    "d3-scale": "4.0.2",
    "ethers": "5.7.2",
    "hark": "1.2.3",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "ml-kmeans": "6.0.0",
    "networkanalysis-ts": "1.0.0",
    "poseidon-lite": "0.3.0",
    "prop-types": "15.7.2",
    "qrcode.react": "4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-redux": "8.0.5",
    "react-router": "6.30.2",
    "react-router-dom": "6.30.2",
    "react-simple-maps": "3.0.0",
    "reactstrap": "9.2.3",
    "recordrtc": "5.6.2",
    "redux": "4.2.1",
    "redux-thunk": "2.4.2",
    "superstruct": "1.0.4",
    "umap-js": "1.4.0",
    "viem": "2.38.3",
    "wagmi": "0.9.6",
    "zod": "3.25.76"
  },
  "scripts": {
    "postinstall": "patch-package",
    "dev": "PUBLIC_URL=/ vite --host 0.0.0.0 --port 3000",
    "analyze": "source-map-explorer 'build/assets/*.js'",
    "start": "serve -s build",
    "build": "PUBLIC_URL=/ vite build",
    "verify:passkey-only-bundle": "node scripts/verify-passkey-only-bundle.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "jest",
    "parity:fixtures": "GENERATE_PARITY_FIXTURES=1 jest --runTestsByPath src/utilities/survey/parityFixtures.test.js --watchAll=false",
    "commonground:export": "GENERATE_COMMONGROUND_EXPORT=1 jest --runTestsByPath src/utilities/survey/commongroundExport.test.js --watchAll=false",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern \"src/**/*.{js,jsx,mjs,cjs,ts,tsx}\"",
    "format:check": "prettier --config .prettierrc.js --ignore-path ../.prettierignore --check \"src/**/*.{js,jsx,mjs,cjs,ts,tsx,css,scss}\""
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/preset-env": "7.29.5",
    "@babel/preset-react": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20.19.39",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/parser": "4.33.0",
    "@vitejs/plugin-react": "4.7.0",
    "babel-jest": "30.4.1",
    "buffer": "6.0.3",
    "eslint": "7.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "patch-package": "8.0.1",
    "process": "0.11.10",
    "sass": "1.78.0",
    "serve": "14.2.6",
    "source-map-explorer": "2.5.3",
    "typescript": "5.8.3",
    "vite": "4.5.14"
  },
  "overrides": {
    "@coinbase/wallet-sdk": {
      "bn.js": "5.2.3"
    },
    "@ethersproject/providers": {
      "ws": "7.5.10"
    },
    "@ethersproject/bignumber": {
      "bn.js": "5.2.3"
    },
    "@ethersproject/signing-key": {
      "bn.js": "5.2.3",
      "elliptic": {
        ".": "6.6.1",
        "bn.js": "4.12.3"
      }
    },
    "@json-rpc-tools/provider": {
      "ws": "7.5.10"
    },
    "@walletconnect/socket-transport": {
      "ws": "7.5.10"
    },
    "@walletconnect/utils": {
      "bn.js": "4.12.3"
    },
    "asn1.js": {
      "bn.js": "4.12.3"
    },
    "axios": "0.31.1",
    "elliptic": {
      "bn.js": "4.12.3"
    },
    "react-simple-maps": {
      "d3-zoom": "3.0.0"
    },
    "@remix-run/router": "1.23.2",
    "follow-redirects": "1.16.0",
    "@metamask/utils": "9.2.0"
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "node": "current"
          }
        }
      ],
      [
        "@babel/preset-react",
        {
          "runtime": "automatic"
        }
      ],
      "@babel/preset-typescript"
    ],
    "plugins": [
      "@babel/plugin-syntax-import-meta"
    ]
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ]
}
