{
  "extends": ["react-app"],
  "plugins": ["prettier", "react-hooks"],
  "globals": {
    "globalThis": "readonly"
  },
  "rules": {
    "prettier/prettier": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "@typescript-eslint/no-unused-vars": "off",
    "no-unused-vars": "off",
    "no-console": ["warn", { "allow": ["info", "warn", "error"] }]
  }
}
