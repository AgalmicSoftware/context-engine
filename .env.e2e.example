# Copy this file to `.env.e2e` (or `.env.e2e.local`) and fill in any required values.
# DO NOT commit `.env.e2e` / `.env.e2e.local` (they may contain secrets).
#
# The E2E runners automatically load `.env.e2e.local` first, then `.env.e2e`.
# Override the file path with:
#   E2E_ENV_FILE=/abs/path/to/file npm run <command>
#
# Debug loader output:
#   E2E_ENV_DEBUG=1 npm run <command>

# ------------------------
# Local App (UI automation)
# ------------------------
BASE_URL=http://127.0.0.1:3000

# ------------------------
# Chain (Optimism Sepolia default)
# ------------------------
# Optional chain selector alias (used by E2E scripts that resolve chain defaults).
# Supports IDs and common names, e.g.:
# CHAIN=11155420
# CHAIN=optimism-sepolia
CHAIN=
# Shared E2E chain runtime selection.
# Current committed runner surface:
# E2E_CHAIN_MODE=onchain
# E2E_CHAIN_MODE=local
# Manual fork workaround today:
# - start a local Anvil fork outside the repo
# - point RPC_URL at that local Anvil endpoint
# - keep CHAIN / CHAIN_ID / SESSION_REGISTRY / SBT_FACTORY aligned to the upstream chain
# Planned first-class fork surface (not yet auto-managed by committed runners):
# E2E_CHAIN_MODE=fork
E2E_CHAIN_MODE=
# Optional upstream metadata for manual-fork reporting when the actual fork source
# differs from the shared default RPC for the selected chain.
# E2E_FORK_RPC_URL=https://your-upstream-rpc.example
E2E_FORK_RPC_URL=
# E2E_FORK_BLOCK_NUMBER=12345678
E2E_FORK_BLOCK_NUMBER=
# E2E_FORK_HOST=127.0.0.1
E2E_FORK_HOST=
# E2E_FORK_PORT=8545
E2E_FORK_PORT=
# CHAIN_ID=11155420
CHAIN_ID=
# Provide your own RPC if you have it. Public RPCs may be rate-limited and cause flaky getLogs/handshake timeouts.
# Recommended for OP Sepolia E2E: a reliable keyed RPC when you have one.
# RPC_URL=https://sepolia.optimism.io
# Legacy Base Sepolia example:
# CHAIN=84532
# CHAIN=base-sepolia
# CHAIN_ID=84532
# RPC_URL=https://base-sepolia-rpc.publicnode.com
# RPC_URL=https://base-sepolia.infura.io/v3/<YOUR_INFURA_KEY>
RPC_URL=

# UI-only: re-enable Pocket-first PATH ordering in the browser (E2E defaults to disabling it).
# E2E_PREFER_PATH_RPC=1
E2E_PREFER_PATH_RPC=

# UI-only: Lit encryption/decrypt behavior in the browser.
# E2E defaults to a deterministic Lit mock for stability (avoids Lit node flake/timeouts).
# Set to 0 to run against real Lit nodes.
# E2E_LIT_MOCK=0
E2E_LIT_MOCK=

# Arweave mock behavior for E2E UI and SBT helper flows.
# Source of truth: set this in `.env.e2e` / `.env.e2e.local`.
# Default E2E recommendation is mock-on for stability unless you explicitly want
# created sessions/questions to remain inspectable in a normal browser after the run.
# Set to 0 for real uploads.
E2E_ARWEAVE_MOCK=1

# UI-only: deterministic AI mocks in the browser (no network).
# E2E_AI_MOCK=1
E2E_AI_MOCK=1
E2E_OPENAI_KEY=

# ------------------------
# Lit Chipotle (optional / flow-specific)
# ------------------------
# Used by the standalone worker-mediated Chipotle smoke lanes:
#   npm run ai:test-lit-chipotle:worker
#   npm run ai:test-lit-chipotle:runtime
#   npm run ai:test-lit-chipotle:doc-live
# Preferred for day-to-day testing: scoped usage key.
LIT_API_BASE=https://api.chipotle.litprotocol.com
LIT_USAGE_API_KEY=
# Optional account-key fallback when you intentionally want worker-env auth
# instead of a per-session secret override.
LIT_ACCOUNT_API_KEY=
# Optional group / PKP / action identifiers for configured-CID checks.
# When combined with LIT_ACCOUNT_API_KEY, the live runtime/doc runners reuse
# that exact Lit runtime and derive only the missing session usage key.
LIT_GROUP_ID=
LIT_PKP_ID=
LIT_ACTION_CID=
# Execute mode:
# - inline: run a tiny inline action through the worker adapter
# - configured: use LIT_ACTION_CID from worker config
# - skip: status-only probe
LIT_E2E_EXECUTE_MODE=inline
# Optional: force the local smoke runner to use worker env fallback for the
# usage key instead of saving it through /admin/set-secrets.
LIT_E2E_USE_WORKER_ENV_FALLBACK=
# Authenticated runtime smoke inputs. The runtime runner exercises the same
# `/lit/chipotle-action` route used by the browser hooks once a session has
# worker-managed `litCredentials`.
LIT_E2E_RUNTIME_ADDRESS=
LIT_E2E_SBT_ADDRESSES=
# Optional override when the gate chain differs from the main `CHAIN_ID` above.
LIT_E2E_GATE_CHAIN_ID=
LIT_E2E_GATE_MODE=any
# Optional: when omitted, the runtime runner uses a fixed 32-byte CEK-like hex payload.
LIT_E2E_MESSAGE_HEX=
# Optional: when session Lit identifiers are missing but `LIT_ACCOUNT_API_KEY`
# is present, the runtime runner bootstraps the missing group / PKP / usage key
# and auto-registers the default CE action before testing.
LIT_E2E_AUTO_PROVISION=1
# Optional custom RPC secrets. If unset, the runtime runner falls back to
# `LIT_E2E_GATE_CHAIN_ID` or `CHAIN_ID` and uses built-in public RPC defaults.
CUSTOM_RPC_URL=
CUSTOM_RPC_KEY=
# Optional smoke-runner artifact controls. Set `LIT_E2E_PERSIST_ARTIFACTS=0`
# when running inside a read-only/sandboxed environment, or override the JSON
# output path with `LIT_E2E_ARTIFACT_JSON=/tmp/ce-chipotle-runtime.json`.
LIT_E2E_PERSIST_ARTIFACTS=
LIT_E2E_ARTIFACT_JSON=
# Optional doc-live runner tuning. The live doc roundtrip auto-derives the
# uploader wallet from PASSKEY_RAW_ID_B64URL, creates a second holder if needed,
# and verifies deny/succeed decrypt behavior against the same uploaded document.
LIT_E2E_DOC_DOWNLOAD_RETRY_ATTEMPTS=
LIT_E2E_DOC_DOWNLOAD_RETRY_DELAY_MS=
# Optional: reuse an already-uploaded encrypted PDF tx instead of creating a
# fresh upload every run. Useful when Arweave propagation is the only blocker
# and you want to retry just the decrypt leg.
LIT_E2E_DOC_TX_ID=
LIT_E2E_VIEWER_SEED=
LIT_E2E_DENIED_SEED=
LIT_E2E_VIEWER_CLAIM_GAS_LIMIT=
LIT_E2E_MIN_VIEWER_BALANCE_ETH=
LIT_E2E_FUND_VIEWER_AMOUNT_ETH=

# UI-only: enable Dev/E2E TestID API-driven nav overlay.
# E2E_NAV=1
E2E_NAV=

# UI-only: enable Agent Mode (window.__ceAgent + /agent).
# E2E_AGENT_MODE=1
E2E_AGENT_MODE=

# Optional overrides (defaults are sourced from client chain config if present).
# SESSION_REGISTRY=0xDcB1731984E9F75c6a061c38dD8b67d18De4C0c1
SESSION_REGISTRY=
# SBT_FACTORY=0x8CBeE1EE46603b446b499cb32F63fa9860a50478
SBT_FACTORY=
# SBT tokenURI fallback for flows that do not auto-upload metadata.
# Must resolve to an Arweave tx (ar://<txId>, arweave gateway URL, or raw txId).
# Note: when E2E_ARWEAVE_MOCK=0, shared E2E SBT mint helpers auto-upload per-SBT
# metadata to Arweave using ARWEAVE_JWK_PATH/ARWEAVE_JWK_JSON and override this value.
# SBT_METADATA_URI=ar://HLDsCm3ALbbgjVTCPVLhU8aF9taAdKyD1DyB7A8zkaXM
SBT_METADATA_URI=
# Optional alias used by profile-driven E2E scripts (falls back to SBT_METADATA_URI when empty).
# E2E_SBT_METADATA_URI=ar://HLDsCm3ALbbgjVTCPVLhU8aF9taAdKyD1DyB7A8zkaXM
E2E_SBT_METADATA_URI=

# Optional explicit session slug. Some flows generate a fresh timestamped slug when unset;
# others expect an existing on-chain session with a worker URL already configured.
# SESSION_SLUG=<your-session-slug>
SESSION_SLUG=

# ------------------------
# Deterministic Test Wallets (NOT secrets)
# ------------------------
# The scripts derive passkey EOA keys from deterministic mock PRF outputs for
# these fixture rawIds (do not use on mainnet).
# If unset, scripts fall back to repo fixtures.
# You must fund the derived PASSKEY_A address on the target chain for on-chain E2E runs.
# Example fixtures:
# PASSKEY_A=AQIDBAUGBwgJCgsMDQ4PEA
# PASSKEY_B=EBESExQVFhcYGRobHB0eHw
# PASSKEY_C=ICEiIyQlJicoKSorLC0uLw
# PASSKEY_D=MDEyMzQ1Njc4OTo7PD0-Pw
# PASSKEY_E=QEFCQ0RFRkdISUpLTE1OTw
PASSKEY_RAW_ID_B64URL=
PASSKEY_A=
PASSKEY_B=
PASSKEY_C=
PASSKEY_D=
PASSKEY_E=

# Derived addresses:
# PASSKEY_A -> 0x2e74fDDd31c0CA80e421Abf6B320209B391BB5bB
# PASSKEY_B -> 0xa5454D0B475d2091479d4c2ab5eb5C3b355E69cE
# PASSKEY_C -> 0x10da84f812168Bb5c2ddDB2d50deFDDF639ee5D4
# PASSKEY_D -> 0x68673582c51DC5328f4193aC8e3452E118Bd4A01
# PASSKEY_E -> 0x61bA254aDC711C312752265a1ead9Ca274dc5568

# Optional: fund walletB from walletA in some flows if walletB is empty.
FUND_WALLET_B=

# ------------------------
# Worker (required for ai:test-gates:any-all in practice)
# ------------------------
# Example:
# SESSION_WORKER_URL=https://<your-ContextEngineSessionCorsWorker>.workers.dev
# Worker URL resolution order (roughly):
# 1) --worker-url (per-run), then SESSION_WORKER_URL / SESSION_CORS_WORKER_URL / CE_SESSION_WORKER_BASE_URL
# 2) legacy WORKER_URL, unless it appears to point at the agent bridge worker
# 3) on-chain SessionRegistry `corsWorkerUrl` (if it is a valid http(s) URL)
# 4) client default `CLOUDFLARE_CORS_WORKER_URL`
# Keep Telegram/agent bridge endpoints separate:
# AGENT_BRIDGE_PUBLIC_URL=https://<your-agentBridgeWorker>.workers.dev
SESSION_WORKER_URL=
WORKER_URL=
# Escape hatch for explicit bridge tests that intentionally overload WORKER_URL.
E2E_ALLOW_WORKER_URL_AGENT_BRIDGE=

# Full private suite session target behavior:
# - By default, scripts/run-e2e-suite.js and ai:test-e2e:encryption-gates create a fresh session target.
# - If CLOUDFLARE_API_TOKEN is set, the default fresh profile deploys a custom session worker.
# - The shared/default worker profile is only appropriate when that worker accepts the target session slug.
# - Set E2E_SUITE_ENSURE_SESSION=0 to skip setup, or E2E_SUITE_REUSE_SESSION_TARGET=1 to reuse SESSION_SLUG/latest artifacts.
E2E_SUITE_ENSURE_SESSION=
E2E_SUITE_REUSE_SESSION_TARGET=
# E2E_SUITE_SESSION_PROFILE=custom-worker-secrets-v1
# E2E_SUITE_SESSION_PROFILE=default-worker-minimal-v1
E2E_SUITE_SESSION_PROFILE=

# ------------------------
# Arweave (required for doc library upload/decrypt flows)
# ------------------------
# Provide an Arweave JWK for a dedicated test wallet (never commit it).
# Unsupported previous local file convention: `.e2e-secrets/arweave-jwk.json`
# Preferred: point at a local JSON file outside the repo when possible.
# Helper: `npm run -s arweave:jwk:generate -- --output .keys/arweave-test-wallet.jwk.json`
ARWEAVE_JWK_PATH=/abs/path/to/YOUR_ARWEAVE_TEST_WALLET.jwk.json
# Alternative (not recommended): inline JSON secret (still a secret; avoid shell history).
ARWEAVE_JWK_JSON=YOUR_ARWEAVE_JWK_JSON_HERE
# Legacy alias accepted by some helpers.
ARWEAVE_JWK=YOUR_ARWEAVE_JWK_JSON_HERE

# ------------------------
# Cloudflare (optional)
# ------------------------
# Required for deploy-helper worker deploy flows in ai:test-session-setup:* runners.
# Committed E2E scripts only read this from env / `.env.e2e(.local)`.
# Unsupported previous local file convention: `.e2e-secrets/cloudflare-api-token.txt`
# Helper: `npm run -s cloudflare:token-link -- --slug your-session-slug`
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN_HERE

# ------------------------
# Session Setup Secrets (optional / flow-specific)
# ------------------------
# Used by `scripts/test-session-setup.ui.js` to prefill the faucet private-key secret
# during Session Wizard automation. Committed E2E scripts only read these from env.
# Unsupported previous local file convention: `.e2e-secrets/faucet-private-key.txt`
# Helper: `npm run -s evm:key:generate -- --output .keys/faucet-op-sepolia.key`
FAUCET_PRIVATE_KEY=0xYOUR_TESTNET_ONLY_FAUCET_PRIVATE_KEY_HERE
# Optional alias for the same value:
# Use the same testnet-only key if you prefer the E2E-prefixed name.
E2E_FAUCET_PRIVATE_KEY=0xYOUR_TESTNET_ONLY_FAUCET_PRIVATE_KEY_HERE

# Required for real custom-worker deploy verification when E2E_AI_MOCK=0.
# In mock mode the runner fills a placeholder only to satisfy UI validation.
E2E_OPENAI_KEY=YOUR_OPENAI_API_KEY_HERE

# ------------------------
# Playwright (macOS arm64 helpers)
# ------------------------
# If Playwright ever resolves x64 paths on an arm64 host, force host platform:
# PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=mac14-arm64
PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=

# Optional explicit browser binary (otherwise Playwright-managed Chromium is used).
PLAYWRIGHT_EXECUTABLE_PATH=

# Launch strategy:
# - explicit-only: do NOT fall back to playwright/default executable paths
# - multi: try explicit -> playwrightResolved -> default
PLAYWRIGHT_LAUNCH_STRATEGY=
# Explicit override:
# PLAYWRIGHT_ALLOW_FALLBACK=0
PLAYWRIGHT_ALLOW_FALLBACK=

# Retry tuning
PLAYWRIGHT_LAUNCH_ATTEMPTS=
PLAYWRIGHT_LAUNCH_TIMEOUT_MS=
PLAYWRIGHT_LAUNCH_BACKOFF_MS=
