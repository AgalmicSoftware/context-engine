#!/usr/bin/env bash
set -euo pipefail

REMOTE_NAME="${1:-}"
REMOTE_URL="${2:-}"
ZERO_OID="0000000000000000000000000000000000000000"

should_protect_remote() {
  case "$REMOTE_NAME" in
    origin)
      return 0
      ;;
  esac

  case "$REMOTE_URL" in
    *AgalmicSoftware/context-engine*)
      return 0
      ;;
  esac

  return 1
}

is_protected_branch_ref() {
  local ref_name="$1"

  case "$ref_name" in
    refs/heads/dev|refs/heads/codex/*|refs/heads/claude/*|refs/heads/edge-*)
      return 0
      ;;
  esac

  return 1
}

if ! should_protect_remote; then
  exit 0
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_ref:-}" ] || continue

  if [ "${local_sha:-}" = "$ZERO_OID" ] || [ "$local_ref" = "(delete)" ]; then
    continue
  fi

  if is_protected_branch_ref "$local_ref" || is_protected_branch_ref "$remote_ref"; then
    printf 'Blocked push of protected private branch ref to %s.\n' "$REMOTE_NAME" >&2
    printf 'Use `scripts/sync-public-history.sh` to publish a stripped public replay branch instead.\n' >&2
    printf 'Remote deletion of leaked protected branches remains allowed.\n' >&2
    exit 1
  fi
done

exit 0
