#!/usr/bin/env bash
set -euo pipefail

REMOTE_NAME="${1:-}"
REMOTE_URL="${2:-}"
ZERO_OID="0000000000000000000000000000000000000000"

should_protect_remote() {
  case "$REMOTE_NAME" in
    origin)
      return 0
      ;;
  esac

  case "$REMOTE_URL" in
    *AgalmicSoftware/context-engine*)
      return 0
      ;;
  esac

  return 1
}

is_allowed_public_ref() {
  local ref_name="$1"

  case "$ref_name" in
    refs/heads/main|refs/heads/release-staging*|refs/tags/*)
      return 0
      ;;
  esac

  return 1
}

consume_push_override() {
  local git_dir
  local override_path

  git_dir="$(git rev-parse --git-dir 2>/dev/null || true)"
  [ -n "$git_dir" ] || return 1

  override_path="$git_dir/CE_PUSH_OVERRIDE"
  [ -f "$override_path" ] || return 1

  rm -f "$override_path"
  printf 'warning: consumed one-time CE push override for %s.\n' "${REMOTE_NAME:-remote}" >&2
  return 0
}

if ! should_protect_remote; then
  exit 0
fi

blocked_refs=()
release_candidate_shas=()
release_baseline_shas=()

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_ref:-}" ] || continue

  if [ "${local_sha:-}" = "$ZERO_OID" ] || [ "$local_ref" = "(delete)" ]; then
    continue
  fi

  if ! is_allowed_public_ref "$remote_ref"; then
    blocked_refs+=("$remote_ref")
    continue
  fi

  case "$remote_ref" in
    refs/heads/release-staging*)
      release_candidate_shas+=("$local_sha")
      release_baseline_shas+=("$remote_sha")
      ;;
  esac

  case "$local_ref" in
    refs/heads/*|refs/tags/*)
      if ! is_allowed_public_ref "$local_ref"; then
        blocked_refs+=("$local_ref")
      fi
      ;;
  esac
done

if [ "${#blocked_refs[@]}" -gt 0 ]; then
  if consume_push_override; then
    exit 0
  fi

  printf 'Blocked push to public Context Engine remote %s.\n' "${REMOTE_NAME:-remote}" >&2
  printf 'Allowed refs are refs/heads/main, refs/heads/release-staging*, and refs/tags/*.\n' >&2
  printf 'Rejected ref: %s\n' "${blocked_refs[0]}" >&2
  exit 1
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
for index in "${!release_candidate_shas[@]}"; do
  candidate_sha="${release_candidate_shas[$index]}"
  baseline_sha="${release_baseline_shas[$index]}"
  verify_args=(
    verify-ref
    --repo-root "$repo_root"
    --candidate-ref "$candidate_sha"
  )

  if [ "$baseline_sha" != "$ZERO_OID" ]; then
    verify_args+=(--minimum-ref "$baseline_sha")
  fi

  main_ref="refs/remotes/${REMOTE_NAME}/main"
  if git rev-parse --verify --quiet "${main_ref}^{commit}" >/dev/null; then
    verify_args+=(--baseline-ref "$main_ref")
  fi

  if ! node "$repo_root/scripts/release-version.mjs" "${verify_args[@]}" >&2; then
    printf 'Blocked release-staging push: public application version verification failed.\n' >&2
    exit 1
  fi
done

exit 0
