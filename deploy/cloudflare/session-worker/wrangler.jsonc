{
  "name": "context-engine-session",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "GROUP_KV"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CE_SESSION_COORDINATOR",
        "class_name": "SessionWriteCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "ce-session-write-coordinator-v1",
      "new_sqlite_classes": [
        "SessionWriteCoordinator"
      ]
    }
  ],
  "vars": {
    "DEFAULT_SESSION_SLUG": "replace-with-session-slug",
    "BOOTSTRAP_ADMIN_ADDRESS": "replace-with-context-engine-admin-address",
    "CE_WORKER_GROUPS_BOOTSTRAP": "fresh-template-v2",
    "CE_STORAGE_IN_GROUP_KV": "1",
    "DEPLOY_HELPER_ENABLED": "0",
    "WORKER_DEBUG_LOGS": "0",
    "CE_BUNDLE_SHA256": "947160e7e6d6d06e4186722b6c3e6ad89e04cee683719db00572ff2eb1cc45d9"
  }
}
