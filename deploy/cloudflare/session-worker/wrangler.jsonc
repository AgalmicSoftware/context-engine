{
  "name": "context-engine-session",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "GROUP_KV"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CE_SESSION_COORDINATOR",
        "class_name": "SessionWriteCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "ce-session-write-coordinator-v1",
      "new_sqlite_classes": [
        "SessionWriteCoordinator"
      ]
    }
  ],
  "vars": {
    "DEFAULT_SESSION_SLUG": "replace-with-session-slug",
    "BOOTSTRAP_ADMIN_ADDRESS": "replace-with-context-engine-admin-address",
    "CE_WORKER_GROUPS_BOOTSTRAP": "fresh-template-v2",
    "CE_STORAGE_IN_GROUP_KV": "1",
    "DEPLOY_HELPER_ENABLED": "0",
    "WORKER_DEBUG_LOGS": "0",
    "CE_BUNDLE_SHA256": "2e2e34257e3229efc44a959317db1ee073650e6f35de9d3782edcab939a3c7ed"
  }
}
