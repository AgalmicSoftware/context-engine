{
  "name": "context-engine-session",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "GROUP_KV"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CE_SESSION_COORDINATOR",
        "class_name": "SessionWriteCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "ce-session-write-coordinator-v1",
      "new_sqlite_classes": [
        "SessionWriteCoordinator"
      ]
    }
  ],
  "vars": {
    "DEFAULT_SESSION_SLUG": "replace-with-session-slug",
    "BOOTSTRAP_ADMIN_ADDRESS": "replace-with-context-engine-admin-address",
    "CE_WORKER_GROUPS_BOOTSTRAP": "fresh-template-v2",
    "DEPLOY_HELPER_ENABLED": "0",
    "WORKER_DEBUG_LOGS": "0",
    "CE_BUNDLE_SHA256": "6c202b8d9b269804a87f631f6be743a0b8d0e2f5e332dfecc454c22d66fa7efb"
  }
}
