CLOUDFLARE_API_TOKEN=PLACEHOLDER_SCOPED_CLOUDFLARE_TOKEN
CLOUDFLARE_WORKERS_SUBDOMAIN=your-workers-subdomain
AGENT_BRIDGE_WORKER_NAME=ce-agent-bridge-worker
# Default live Telegram smoke provisions only KV plus Worker/DO bindings. Set
# true only when explicitly testing bridge-owned R2/D1 demo doc/artifact storage.
AGENT_BRIDGE_ENABLE_DOC_STORAGE=false

TELEGRAM_BOT_TOKEN=PLACEHOLDER_TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_USERNAME=your_context_engine_bot
TELEGRAM_WEBHOOK_SECRET=PLACEHOLDER_RANDOM_WEBHOOK_SECRET
DEMO_SIGNER_ROOT_SECRET=PLACEHOLDER_RANDOM_DEMO_SIGNER_ROOT_SECRET
# Optional: lets Telegram bridge AI features send a request-local key to the
# session worker /ai and /transcribe routes when that session worker has no
# per-session openaiKey secret yet.
AGENT_BRIDGE_OPENAI_API_KEY=sk-...

CE_SESSION_WORKER_BASE_URL=https://your-session-worker.your-workers-subdomain.workers.dev
DEFAULT_CHAIN_ID=11155420
DEFAULT_RPC_URL=https://op-sepolia-testnet.api.pocket.network
# Optional additive fallback. This does not replace DEFAULT_RPC_URL; the Worker
# tries DEFAULT_RPC_URL first and then this URL for live SessionRegistry reads.
# ADDITIONAL_RPC_URL=https://your-op-sepolia-rpc.example
# Default question source is live. Use fixture only for local preview/demo copy.
# Mock Telegram preview routes are disabled by default; enable only for local
# browser/copy testing, not live deployments.
# AGENT_BRIDGE_ENABLE_TELEGRAM_PREVIEW=true
# Optional Mini App overrides. Defaults to $AGENT_BRIDGE_PUBLIC_URL/telegram/mini-app.
# AGENT_BRIDGE_MINI_APP_URL=https://ce-agent-bridge-worker.your-workers-subdomain.workers.dev/telegram/mini-app
# AGENT_BRIDGE_MINI_APP_AUTH_MAX_AGE_SECONDS=86400
# AGENT_BRIDGE_QUESTION_SOURCE=fixture
# AGENT_BRIDGE_RPC_TIMEOUT_MS=5000
# AGENT_BRIDGE_QUESTION_CACHE_TTL_SECONDS=300
# AGENT_BRIDGE_QUESTION_PAYLOAD_CONCURRENCY=4
# AGENT_BRIDGE_QUESTION_FOREGROUND_CHUNKS=1
# AGENT_BRIDGE_QUESTION_PAYLOAD_TIMEOUT_MS=2500
# Live question scans prefer session metadata blockLimits, then the registry
# SessionCreated block for the exact slug, before any explicit debug bounds.
# AGENT_BRIDGE_QUESTION_SCAN_START_BLOCK=0
# AGENT_BRIDGE_QUESTION_SCAN_END_BLOCK=
# Emergency/debug only: allows recent-block fallback when no scoped bounds exist.
# AGENT_BRIDGE_ALLOW_UNSCOPED_QUESTION_SCAN=1

# Optional developer fallback only. The setup UX and deploy plan derive the
# account from CLOUDFLARE_API_TOKEN and block if multiple accounts are visible.
# CLOUDFLARE_ACCOUNT_ID=PASTE_ONLY_IF_DEBUGGING_MANUAL_ACCOUNT_SELECTION

# Opt-in only: makes deploy:plan call Cloudflare /accounts?per_page=2 to derive
# one account from CLOUDFLARE_API_TOKEN. Leave unset for offline/mocked planning.
# AGENT_BRIDGE_LIVE_ACCOUNT_LOOKUP=1
