# Local operator configuration only; do not deploy CLOUDFLARE_API_TOKEN as a Worker secret.
CLOUDFLARE_API_TOKEN=PLACEHOLDER_SCOPED_CLOUDFLARE_TOKEN
CLOUDFLARE_WORKERS_SUBDOMAIN=your-workers-subdomain
AGENT_BRIDGE_WORKER_NAME=ce-agent-bridge-worker
DEMO_SIGNER_ROOT_SECRET=PLACEHOLDER_RANDOM_DEMO_SIGNER_ROOT_SECRET
AGENT_BRIDGE_AGENT_API_TOKEN=PLACEHOLDER_RANDOM_AGENT_API_TOKEN
AGENT_BRIDGE_DEPLOYMENT_ID=local-demo
AGENT_BRIDGE_PUBLIC_URL=https://ce-agent-bridge-worker.your-workers-subdomain.workers.dev
CE_SESSION_WORKER_BASE_URL=https://your-session-worker.your-workers-subdomain.workers.dev
DEFAULT_CHAIN_ID=11155420
DEFAULT_RPC_URL=https://op-sepolia-testnet.api.pocket.network
# Optional additive fallback; DEFAULT_RPC_URL remains first.
# ADDITIONAL_RPC_URL=https://your-op-sepolia-rpc.example
# Optional provider key for authorized Session Worker AI requests.
# AGENT_BRIDGE_OPENAI_API_KEY=PLACEHOLDER_PROVIDER_KEY
# Browser login origins; the old MINIAPP_ALLOWED_ORIGINS name is read-only compatibility.
# AGENT_BRIDGE_CLIENT_LOGIN_ALLOWED_ORIGINS=https://contextengine.sh,https://contextengine.xyz
# Optional admin metrics visibility cutoff; historical *_TELEGRAM_* names remain aliases.
# AGENT_BRIDGE_SESSION_CREATED_AFTER=2026-01-01T00:00:00Z
# Dedicated deployments require one explicit session and an exactly matching Worker origin.
# AGENT_BRIDGE_SESSION_POLICY_JSON={"version":1,"defaultSessionSlug":"sample","sessions":[{"sessionSlug":"sample","sessionWorkerUrl":"https://your-session-worker.your-workers-subdomain.workers.dev","sessionModeProfile":{"authority":{"mode":"worker_canonical"},"surfaces":{"agentHttp":true,"telegram":false,"miniApp":false}}}]}
# Optional local non-identifying question fixtures.
# AGENT_BRIDGE_QUESTION_SOURCE=fixture
# AGENT_BRIDGE_DEMO_QUESTIONS_JSON=[{"questionId":"q-readiness","questionType":"freeform","prompt":"What should this group decide next?"}]
# AGENT_BRIDGE_QUESTION_LIVE_FALLBACK_TIMEOUT_MS=2500
# AGENT_BRIDGE_RPC_TIMEOUT_MS=5000
# AGENT_BRIDGE_QUESTION_PAYLOAD_TIMEOUT_MS=2500
# AGENT_BRIDGE_QUESTION_CACHE_TTL_SECONDS=300
# AGENT_BRIDGE_QUESTION_PAYLOAD_CONCURRENCY=4
# AGENT_BRIDGE_QUESTION_FOREGROUND_CHUNKS=1
# Scoped scans prefer metadata blockLimits, then the exact session's creation block.
# AGENT_BRIDGE_QUESTION_SCAN_START_BLOCK=0
# AGENT_BRIDGE_QUESTION_SCAN_END_BLOCK=
# Emergency/debug only: allow recent-block fallback without scoped bounds.
# AGENT_BRIDGE_ALLOW_UNSCOPED_QUESTION_SCAN=1
# Optional named response/admin allowlist.
# AGENT_BRIDGE_RESPONSE_EXPORT_ALLOWED_ADDRESSES=0x0000000000000000000000000000000000000000
# Optional 7-day Agent Only credential lifetime.
# AGENT_BRIDGE_AGENT_ONLY_TOKEN_TTL_SECONDS=604800
# Optional developer fallback; apply derives the single visible account.
# CLOUDFLARE_ACCOUNT_ID=PLACEHOLDER_ACCOUNT_ID
# Opt-in live account lookup for planning; keep unset for offline checks.
# AGENT_BRIDGE_LIVE_ACCOUNT_LOOKUP=1
AGENT_AI_PROVIDER=ce_session_policy
BROADCAST_ENABLED=true
AGENT_BRIDGE_DIRECT_SUBMIT_ENABLED=true
# Enable only after configuring AGENT_RESPONSE_QUEUE and its dead-letter queue.
AGENT_BRIDGE_ASYNC_SUBMIT_ENABLED=false
AGENT_BRIDGE_SUBMIT_MAX_ATTEMPTS=4
AGENT_BRIDGE_SUBMIT_RETRY_DELAY_SECONDS=60
