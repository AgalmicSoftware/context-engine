{
  "schemaVersion": 1,
  "profiles": {
    "ci": [
      "wiring-and-release",
      "contracts",
      "client",
      "root-jest",
      "workers",
      "cecc-and-node"
    ],
    "hosted": [
      "wiring-and-release",
      "contracts",
      "client",
      "root-jest",
      "workers",
      "cecc-and-node"
    ],
    "release": [
      "release"
    ]
  },
  "gates": {
    "wiring-and-release": {
      "commands": [
        {
          "label": "Check test and release wiring",
          "command": "npm",
          "args": [
            "run",
            "test:wiring"
          ]
        },
        {
          "label": "Check type debt ratchet",
          "command": "npm",
          "args": [
            "run",
            "type-debt:check"
          ]
        },
        {
          "label": "Lint client",
          "command": "npm",
          "args": [
            "run",
            "lint"
          ]
        },
        {
          "label": "Lint workers",
          "command": "npm",
          "args": [
            "run",
            "lint:workers"
          ]
        },
        {
          "label": "Typecheck client",
          "command": "npm",
          "args": [
            "run",
            "typecheck:client"
          ]
        },
        {
          "label": "Verify public release surface",
          "command": "npm",
          "args": [
            "run",
            "verify:public-release-surface"
          ]
        },
        {
          "label": "Build worker bundles",
          "command": "npm",
          "args": [
            "run",
            "worker:bundle"
          ]
        },
        {
          "label": "Verify worker bundle sync",
          "command": "npm",
          "args": [
            "run",
            "verify:worker-bundle"
          ]
        },
        {
          "label": "Build client",
          "command": "npm",
          "args": [
            "--prefix",
            "client",
            "run",
            "build"
          ]
        }
      ]
    },
    "contracts": {
      "commands": [
        {
          "label": "Run contract tests and build artifacts",
          "command": "npm",
          "args": [
            "run",
            "test:contracts"
          ]
        }
      ]
    },
    "client": {
      "commands": [
        {
          "label": "Run client coverage tests",
          "command": "npm",
          "args": [
            "run",
            "test:client"
          ]
        }
      ]
    },
    "root-jest": {
      "commands": [
        {
          "label": "Run root Jest tests",
          "command": "npm",
          "args": [
            "run",
            "test:root:jest"
          ]
        }
      ]
    },
    "workers": {
      "commands": [
        {
          "label": "Run session CORS Worker tests",
          "command": "npm",
          "args": [
            "run",
            "test:worker:session-cors"
          ]
        },
        {
          "label": "Run Agent Bridge Worker tests",
          "command": "npm",
          "args": [
            "run",
            "test:worker:agent-bridge"
          ]
        }
      ]
    },
    "cecc-and-node": {
      "commands": [
        {
          "label": "Run managed-cache guard",
          "command": "npm",
          "args": [
            "run",
            "test:cache-guard"
          ]
        }
      ]
    },
    "release": {
      "commands": [
        {
          "label": "Lint client",
          "command": "npm",
          "args": [
            "run",
            "lint"
          ]
        },
        {
          "label": "Typecheck client",
          "command": "npm",
          "args": [
            "run",
            "typecheck:client"
          ]
        },
        {
          "label": "Run full client release tests",
          "command": "npm",
          "args": [
            "run",
            "test:release:client"
          ]
        },
        {
          "label": "Verify public release surface",
          "command": "npm",
          "args": [
            "run",
            "verify:public-release-surface"
          ]
        },
        {
          "label": "Build worker bundles",
          "command": "npm",
          "args": [
            "run",
            "worker:bundle"
          ]
        },
        {
          "label": "Verify worker bundle sync",
          "command": "npm",
          "args": [
            "run",
            "verify:worker-bundle"
          ]
        },
        {
          "label": "Build client",
          "command": "npm",
          "args": [
            "--prefix",
            "client",
            "run",
            "build"
          ]
        }
      ]
    }
  }
}
