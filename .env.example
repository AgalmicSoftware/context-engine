# Root env reference for scripts and E2E runs.
#
# Root scripts auto-load `.env.e2e.local` first, then `.env.e2e`.
# This file is the canonical reference for root-level variables; copy the
# values you need into `.env.e2e.local` for local runs.
#
# Public client `REACT_APP_*` variables belong in `client/.env`.
# See `client/.env.example`.

# ------------------------
# Common local app target
# Required for UI/E2E flows
# ------------------------
BASE_URL=http://127.0.0.1:3000

# ------------------------
# Chain
# Required for most on-chain E2E flows
# Optimism Sepolia is the canonical OSS default chain.
# Base Sepolia is best-effort legacy/dev compatibility, not an active support target.
# ------------------------
CHAIN=optimism-sepolia
CHAIN_ID=11155420
RPC_URL=
# Legacy Base Sepolia example:
# CHAIN=base-sepolia
# CHAIN_ID=84532

# ------------------------
# Session / worker targeting
# Usually required for targeted flows
# ------------------------
SESSION_SLUG=
WORKER_URL=
METADATA_URI=

# ------------------------
# Deterministic test wallets
# Optional if repo defaults are sufficient; required when a specific funded
# wallet fixture is needed for a run.
# ------------------------
PASSKEY_A=
PASSKEY_B=
PASSKEY_C=
FUND_WALLET_B=
FUND_WALLET_C=

# ------------------------
# Arweave
# Required for document upload/decrypt and metadata-upload flows
# ------------------------
# Generate a local file with: `npm run -s arweave:jwk:generate -- --output .keys/arweave-upload.jwk.json`
ARWEAVE_JWK_PATH=
ARWEAVE_JWK_JSON=
ARWEAVE_JWK=

# ------------------------
# Cloudflare
# Required for custom-worker deploy/session-setup flows
# ------------------------
# Helper: `npm run -s cloudflare:token-link -- --slug your-session-slug`
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ------------------------
# Playwright
# Optional overrides
# ------------------------
PLAYWRIGHT_WS_ENDPOINT=
PLAYWRIGHT_EXECUTABLE_PATH=

# ------------------------
# E2E loader / cache controls
# Optional
# ------------------------
E2E_ENV_FILE=
E2E_CACHE_DIR=.e2e-cache
E2E_CACHE_TTL_HOURS=
NO_CLEANUP=
FORCE_FRESH_SESSION_SLUG=
REUSE_SESSION_SLUG=
