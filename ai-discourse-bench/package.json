{
  "name": "ai-discourse-bench",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Self-contained Context Engine benchmark folder for mapping AI model agreement and disagreement over AI discourse questions.",
  "license": "MPL-2.0",
  "bin": {
    "ai-discourse-bench": "./bin/ai-discourse-bench.mjs"
  },
  "scripts": {
    "build:candidate-bank": "node ./scripts/build-candidate-bank.mjs",
    "build:reviewed-candidate-bank": "node ./scripts/build-reviewed-candidate-bank.mjs",
    "audit:development-bank": "node ./scripts/audit-development-question-bank.mjs",
    "evaluate:questions": "node ./scripts/evaluate-question-results.mjs",
    "generate:questions": "node ./scripts/generate-sample-question-bank.mjs",
    "validate": "node ./bin/ai-discourse-bench.mjs validate --questions ./data/question-bank.sample.json --models ./data/model-roster.sample.json --personas ./data/personas.sample.json",
    "test": "node --test",
    "check:results-sync": "node ./scripts/check-context-engine-results-sync.mjs",
    "check:static-publication": "node ./scripts/verify-static-publication.mjs",
    "sync:results-snapshot": "node ./scripts/check-context-engine-results-sync.mjs --write",
    "run:mock": "node ./bin/ai-discourse-bench.mjs run --provider mock --questions ./data/question-bank.sample.json --models ./data/model-roster.sample.json --out ./runs/mock-self-runs.json --repeats 1",
    "run:mock:importance": "node ./bin/ai-discourse-bench.mjs run-importance --provider mock --questions ./data/question-bank.sample.json --models ./data/model-roster.sample.json --out ./runs/mock-importance-runs.json --budget 100 --repeats 1",
    "run:mock:persona": "node ./bin/ai-discourse-bench.mjs run --provider mock --mode persona --persona ada-lovelace --questions ./data/question-bank.sample.json --models ./data/model-roster.sample.json --personas ./data/personas.sample.json --out ./runs/mock-ada-runs.json --repeats 1",
    "report:mock": "node ./bin/ai-discourse-bench.mjs build-report --questions ./data/question-bank.sample.json --models ./data/model-roster.sample.json --runs ./runs/mock-self-runs.json --importance ./runs/mock-importance-runs.json --out ./results/mock-self-report.json",
    "render:mock": "node ./bin/ai-discourse-bench.mjs render-report --report ./results/mock-self-report.json --out ./results/mock-self-report.html",
    "publish:static": "node ./scripts/publish-static-report.mjs",
    "export:ce:mock": "node ./bin/ai-discourse-bench.mjs export-ce --report ./results/mock-self-report.json --out ./results/mock-self-ce-polis-export.json",
    "export:ce:native:mock": "node ./bin/ai-discourse-bench.mjs export-ce-native --report ./results/mock-self-report.json --out ./results/mock-self-ce-native.json",
    "snapshot:mock": "node ./bin/ai-discourse-bench.mjs snapshot-report --report ./results/mock-self-report.json --out ./results/mock-self-snapshot.json --label mock-self",
    "export:analysis:mock": "node ./bin/ai-discourse-bench.mjs export-analysis-input --report ./results/mock-self-report.json --out ./results/mock-self-ai-analysis-input.json",
    "local:full": "node ./scripts/run-local-full.mjs",
    "openrouter:audit": "node ./scripts/audit-openrouter-roster.mjs",
    "openrouter:plan": "node ./bin/ai-discourse-bench.mjs plan-run --provider openrouter --questions ./banks/ai-futures/v0.2-reviewed-candidate/question-bank.json --models ./data/model-roster.openrouter.sample.json --repeats 10",
    "openrouter:full": "node ./scripts/run-openrouter-full.mjs",
    "smoke": "npm run validate && npm test && npm run run:mock && npm run run:mock:importance && npm run report:mock && npm run render:mock && npm run export:ce:mock && npm run export:ce:native:mock && npm run snapshot:mock && npm run export:analysis:mock"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
