{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextengine.org/schemas/ce-benchmark-results-v1.schema.json",
  "title": "Context Engine Benchmark Results Dataset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "sourceReport", "participants", "statements", "responses", "polisReport", "integrity"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "ce_benchmark_results_dataset" },
    "generatedAt": { "type": "string" },
    "sourceReport": { "type": "object" },
    "summaryCorrection": {
      "type": ["object", "null"],
      "description": "Saved-count correction provenance, retained verbatim from the source report; this does not validate the original model runs.",
      "properties": {
        "method": { "type": "string" },
        "sourceReportContentHash": { "type": "string" },
        "sourceCellContentHash": { "type": "string" },
        "correctedAt": { "type": "string" },
        "rawRunsRevalidated": { "type": "boolean" }
      }
    },
    "stanceScale": { "type": "object" },
    "statistics": { "type": "object" },
    "participants": { "type": "array", "items": { "type": "object" } },
    "statements": { "type": "array", "items": { "type": "object" } },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["participantId", "statementId", "summary"],
        "properties": {
          "participantId": { "type": "string" },
          "statementId": { "type": "string" },
          "summary": { "type": ["object", "null"] }
        }
      }
    },
    "polisReport": { "type": "object" },
    "participantGraph": {
      "type": "object",
      "properties": {
        "opinionGroupAvailability": {
          "type": "object",
          "required": ["status", "reason", "interpretation", "eligibleParticipantIds", "missingPairCount"],
          "properties": {
            "status": { "enum": ["available", "unavailable"] },
            "reason": { "enum": [null, "incomplete-pairwise-similarity", "insufficient-eligible-participants"] },
            "interpretation": { "const": "exploratory" },
            "eligibleParticipantIds": { "type": "array", "items": { "type": "string" } },
            "missingPairCount": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "breakdown": { "type": "object" },
    "importance": { "type": "object" },
    "debateAtlas": { "type": "object" },
    "riskMatrix": { "type": "object" },
    "integrity": { "type": "object" },
    "note": { "type": "string" }
  }
}
