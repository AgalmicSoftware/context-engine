{
  "name": "contextEngine",
  "version": "0.1.0",
  "description": "Context Engine — an OSS toolkit for groups",
  "author": "Context Engine Contributors",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AgalmicSoftware/context-engine"
  },
  "bugs": {
    "url": "https://github.com/AgalmicSoftware/context-engine/issues"
  },
  "homepage": "https://contextengine.xyz/",
  "private": true,
  "scripts": {
    "chain:start": "anvil --silent --port 8545 --chain-id 31337 --mnemonic \"test test test test test test test test test test test junk\"",
    "abi:sync": "node scripts/sync-abis.mjs",
    "abi:build": "forge build && node scripts/sync-abis.mjs",
    "worker:bundle": "node scripts/worker-bundle.mjs",
    "demo:analysis:generate": "node scripts/generate-demo-analysis-fixture.mjs",
    "deploy-helper:deploy": "node scripts/deploy-helper-deploy.mjs",
    "deploy:op-sepolia": "node scripts/deploy-op-sepolia.mjs",
    "verify:worker-bundle": "node scripts/verify-worker-bundle-sync.mjs",
    "verify:public-release-surface": "node scripts/verify-public-release-surface.js",
    "verify:public-release-pii": "bash scripts/verify-public-release-pii.sh",
    "arweave:jwk": "npm run -s ai:node -- scripts/arweave-jwk.js",
    "arweave:jwk:generate": "npm run -s ai:node -- scripts/arweave-jwk.js generate",
    "arweave:jwk:inspect": "npm run -s ai:node -- scripts/arweave-jwk.js inspect",
    "evm:key": "npm run -s ai:node -- scripts/evm-key-address.js",
    "evm:key:generate": "npm run -s ai:node -- scripts/evm-key-address.js generate",
    "evm:key:inspect": "npm run -s ai:node -- scripts/evm-key-address.js inspect",
    "evm:key:address": "npm run -s ai:node -- scripts/evm-key-address.js inspect --address-only",
    "cloudflare:token-link": "npm run -s ai:node -- scripts/cloudflare-token-link.js",
    "chain:deploy": "forge build && node scripts/sync-abis.mjs && forge script foundry/script/DeployLocal.s.sol --tc DeployLocal --rpc-url http://127.0.0.1:8545 --broadcast --sender 0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266 --unlocked",
    "test:contracts": "bash -c 'set -euo pipefail; if [ ! -d node_modules/@openzeppelin/contracts ]; then echo \"Error: @openzeppelin/contracts not found. Run npm install first.\"; exit 1; fi; forge test --match-contract \"^(SurveysTest|CustomSBTTest|SessionRegistryTest|SurveysFuzzTest|CustomSBTFuzzTest|SessionRegistryFuzzTest|CustomSBTInvariantTest)$\"'",
    "test:client": "cd client && CI=1 npm test -- --watchAll=false --runInBand --coverage --coverageReporters=lcov --coverageReporters=text-summary",
    "test:root:jest": "cd client && npm test -- --watchAll=false --runInBand --testMatch '<rootDir>/../tests/root/deployHelper.worker.test.js' '<rootDir>/../tests/root/sessionCorsWorker.admin.test.js' '<rootDir>/../tests/root/sessionCorsWorker.arweave.test.js' '<rootDir>/../tests/root/sessionCorsWorker.auth.test.js' '<rootDir>/../tests/root/sessionCorsWorker.authenticatedActions.test.js' '<rootDir>/../tests/root/sessionCorsWorker.authenticatedRoutes.test.js' '<rootDir>/../tests/root/sessionCorsWorker.gates.test.js' '<rootDir>/../tests/root/sessionCorsWorker.health.test.js'",
    "test:worker:session-cors": "npm --prefix workers/sessionCorsWorker test",
    "test:worker:agent-bridge": "node scripts/run-agent-bridge-worker-tests.js",
    "test:cc": "node scripts/run-contextengine-cc-tests.js",
    "test:cc:coverage": "NODE_V8_COVERAGE=coverage node scripts/run-contextengine-cc-tests.js --experimental-test-coverage",
    "test:node": "node scripts/run-node-tests.js",
    "client-boundaries:check": "node scripts/check-client-boundaries.mjs",
    "test:hygiene": "node scripts/check-text-hygiene.mjs",
    "test:wiring": "node scripts/verify-test-wiring.js && node scripts/verify-test-inventory.js && npm run -s client-boundaries:check && npm run -s test:hygiene",
    "test:release:client": "cd client && npm test -- --watchAll=false --runInBand",
    "typecheck:client": "npm --prefix client run typecheck",
    "type-debt:check": "node scripts/check-type-debt-ratchet.mjs",
    "test:ci": "npm run test:wiring && npm run type-debt:check && npm run verify:release && npm run test:contracts && npm run test:client && npm run test:root:jest && npm run test:worker:session-cors && npm run test:cc && npm run test:node && npm run test:cache-guard",
    "test:e2e": "npm run -s test:e2e:smoke",
    "test:e2e:quick": "npm run -s test:e2e:smoke",
    "test:e2e:smoke": "npm run -s ai:test-nav:smoke",
    "test:deep": "npm run -s ai:node -- scripts/run-deep-e2e-tests.js",
    "test:e2e:quick:stability": "bash -c 'set -euo pipefail; RUNS=${E2E_STABILITY_RUNS:-3}; for i in $(seq 1 \"$RUNS\"); do echo \"stability run $i/$RUNS\"; npm run -s test:e2e:quick; done'",
    "tests": "npm run test:ci && npm run test:surveys-sbt",
    "test": "npm run test:ci",
    "test:local": "bash -c 'set -euo pipefail; anvil --silent --port 8545 --chain-id 31337 --mnemonic \"test test test test test test test test test test test junk\" > /tmp/anvil.log 2>&1 & ANVIL_PID=$!; trap \"kill $ANVIL_PID\" EXIT; for i in {1..20}; do if cast block-number --rpc-url http://127.0.0.1:8545 >/dev/null 2>&1; then break; fi; sleep 0.25; done; npm run chain:deploy; (cd client && npm test)'",
    "test:surveys-sbt": "bash -c 'set -euo pipefail; if [ ! -f client/src/utilities/web3/contractScripts.surveys-sbt.proxy.test.js ]; then echo \"Skipping test:surveys-sbt: client proxy test is not present in this checkout.\"; exit 0; fi; anvil --silent --port 8545 --chain-id 31337 --mnemonic \"test test test test test test test test test test test junk\" > /tmp/anvil.log 2>&1 & ANVIL_PID=$!; trap \"kill $ANVIL_PID\" EXIT; for i in {1..20}; do if cast block-number --rpc-url http://127.0.0.1:8545 >/dev/null 2>&1; then break; fi; sleep 0.25; done; npm run chain:deploy; (cd client && NODE_PATH=\"$PWD/node_modules\" CE_RUN_LOCAL_CHAIN_TESTS=1 CI=1 npm test -- --runTestsByPath src/utilities/web3/contractScripts.surveys-sbt.proxy.test.js)'",
    "verify:release": "npm run lint && npm run typecheck:client && npm run test:release:client && npm run verify:public-release-surface && npm run worker:bundle && npm run verify:worker-bundle && npm --prefix client run build",
    "ai:node": "node -r ./scripts/lib/env-loader.js",
    "ai:harness:doctor": "node scripts/ai-harness-doctor.js",
    "ai:playwright-server": "npm run -s ai:node -- scripts/start-playwright-server.js",
    "ai:wallet": "npm run -s ai:node -- scripts/ai-wallet.js",
    "ai:mint-test-sbt": "npm run -s ai:node -- scripts/mint-test-sbt.js",
    "ai:mint-test-sbt:dry": "DRY_RUN=1 npm run -s ai:node -- scripts/mint-test-sbt.js",
    "ai:ux-workflows": "npm run -s ai:node -- scripts/run-ux-workflows.js",
    "ai:capture-ux-screenshots": "npm run -s ai:node -- scripts/capture-ux-screenshots.ui.js",
    "ai:ux-workflows:chain-dry": "AI_INCLUDE_CHAIN=1 npm run -s ai:node -- scripts/run-ux-workflows.js",
    "ai:ux-workflows:chain-live": "AI_INCLUDE_CHAIN=1 AI_LIVE_CHAIN=1 npm run -s ai:node -- scripts/run-ux-workflows.js",
    "ai:test-gates:any-all": "npm run -s ai:node -- scripts/test-session-gates-any-all.js",
    "ai:test-nav:smoke": "node scripts/vite-navigation-smoke.js",
    "ai:test-nav:smoke:mobile": "PLAYWRIGHT_VIEWPORT=mobile npm run -s ai:test-nav:smoke",
    "ai:test-nav:smoke:firefox": "PLAYWRIGHT_BROWSER=firefox npm run -s ai:test-nav:smoke",
    "ai:test-prd648:telegram-client": "npm run -s ai:node -- scripts/test-prd648-telegram-client-login.ui.js",
    "ai:test-prd648:new-mode": "npm run -s ai:node -- scripts/test-prd648-new-mode-presets.ui.js",
    "ai:test-prd648:session-demo": "npm run -s ai:node -- scripts/test-prd648-session-demo.ui.js",
    "ai:test-prd648:closeout-smoke": "npm run -s ai:test-prd648:telegram-client && npm run -s ai:test-prd648:new-mode && npm run -s ai:test-prd648:session-demo",
    "ai:test-prd649:worker-envelope": "npm run -s ai:node -- scripts/e2e/prd652-worker-envelope.js",
    "ai:test-prd650:worker-groups": "npm run -s ai:node -- scripts/e2e/prd652-worker-groups.js",
    "ai:test-prd649-650:group-envelope": "npm run -s ai:node -- scripts/e2e/prd652-group-envelope.js",
    "ai:test-prd649:key-lifecycle": "npm run -s ai:node -- scripts/e2e/prd652-key-lifecycle.js",
    "ai:test-cf-envelope:all": "npm run -s ai:test-prd649:worker-envelope && npm run -s ai:test-prd650:worker-groups && npm run -s ai:test-prd649-650:group-envelope && npm run -s ai:test-prd649:key-lifecycle",
    "ai:test-atlas:historical-cases": "npm run -s ai:node -- scripts/test-atlas-historical-cases.js",
    "ai:test-ai:invocations": "npm run -s ai:node -- scripts/test-ai-invocations.js",
    "ai:test-agent:interface": "npm run -s ai:node -- scripts/test-agent-interface.js",
    "ai:test-doc-library:session": "npm run -s ai:node -- scripts/test-doc-library-session.js",
    "ai:test-doc-library:session:filetypes": "npm run -s ai:node -- scripts/test-doc-library-session-filetypes.js",
    "ai:test-tool-explorer:doc-save": "npm run -s ai:node -- scripts/test-tool-explorer-doc-save.ui.js",
    "ai:seed-survey:question-types": "npm run -s ai:node -- scripts/seed-survey-question-types.js",
    "ai:seed-polis:binary-multi-wallet": "npm run -s ai:node -- scripts/seed-polis-binary-multi-wallet.js",
    "ai:test-gated-decrypt:all-types": "npm run -s ai:node -- scripts/test-session-gated-decrypt-all-types.js",
    "ai:test-session-setup:default-worker": "npm run -s ai:node -- scripts/test-session-setup.js --profile-id default-worker-minimal-v1",
    "ai:test-session-setup:custom-worker-secrets": "npm run -s ai:node -- scripts/test-session-setup.js --profile-id custom-worker-secrets-v1",
    "ai:test-session-setup:custom-worker-no-secrets": "npm run -s ai:node -- scripts/test-session-setup-custom-worker-no-secrets.stub.js",
    "ai:test-session-setup:sponsored-inline-sbt": "npm run -s ai:node -- scripts/test-session-setup.js --profile-id sponsored-inline-sbt-v1",
    "ai:test-profile:sbt-multi-session": "npm run -s ai:node -- scripts/test-profile-sbt-multi-session.js",
    "ai:test-profile:activity-multi-session": "npm run -s ai:node -- scripts/test-profile-activity-multi-session.js",
    "ai:test-sbt-create:variants": "npm run -s ai:node -- scripts/test-sbt-create-variants.js",
    "ai:test-sbt-metadata-locks": "npm run -s ai:node -- scripts/test-sbt-metadata-locks.js",
    "ai:test-sbt:auto-display": "npm run -s ai:node -- scripts/test-sbt-auto-display.ui.js",
    "ai:test-sbt:auto-mint": "npm run -s ai:node -- scripts/test-sbt-auto-mint.ui.js",
    "ai:test-sbt-collect:variants": "npm run -s ai:node -- scripts/test-sbt-collect-variants.js",
    "ai:test-sbt-contract:boundaries": "npm run -s ai:node -- scripts/test-sbt-contract-boundaries.js",
    "ai:test-sbt:onchain:all-functions": "npm run -s ai:test-sbt-create:variants && npm run -s ai:test-sbt-collect:variants && npm run -s ai:test-sbt-contract:boundaries",
    "ai:test-doc-library:session:multi-gate": "npm run -s ai:node -- scripts/test-doc-library-session-multi-gate.js",
    "ai:test-doc-library:url-records": "npm run -s ai:node -- scripts/test-doc-library-url-records.js",
    "ai:test-survey-authoring:encryption-matrix": "npm run -s ai:node -- scripts/test-survey-authoring-encryption-matrix.js",
    "ai:test-survey-response:encryption-matrix": "npm run -s ai:node -- scripts/test-survey-response-encryption-matrix.js",
    "ai:test-survey-gated-decrypt:any-all": "npm run -s ai:node -- scripts/test-survey-gated-decrypt-any-all.js",
    "ai:test-question-filter:test-4": "npm run -s ai:node -- scripts/test-question-filter-test-4.js",
    "ai:test-question-filter:test-4:api": "TEST4_RUN_UI=0 npm run -s ai:node -- scripts/test-question-filter-test-4.js",
    "ai:test-question-filter:test-4:ux": "TEST4_RUN_API=0 npm run -s ai:node -- scripts/test-question-filter-test-4.js",
    "ai:test-admin:gate-update": "npm run -s ai:node -- scripts/test-admin-gate-update.js",
    "ai:test-gate-revocation:decrypt": "npm run -s ai:node -- scripts/test-gate-revocation-decrypt.js",
    "ai:test-worker-scopes:matrix": "npm run -s ai:node -- scripts/test-worker-scopes-matrix.js",
    "ai:test-e2e:encryption-gates": "npm run -s ai:node -- scripts/run-e2e-encryption-gates-suite.js",
    "lint": "cd client && npm run lint",
    "test:cache-guard": "bash ./scripts/check-managed-cache-localstorage.sh"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "arweave": "1.15.7",
    "ethers": "5.7.2",
    "esbuild": "0.25.12",
    "playwright": "1.58.2"
  }
}
