{
  "name": "@agalmic/contextengine",
  "version": "0.1.1",
  "description": "MCP server that lets an AI agent take part in Context Engine sessions as its own participant",
  "license": "MPL-2.0",
  "type": "module",
  "bin": {
    "contextengine": "dist/contextengine.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start": "node bin/context-engine-mcp.mjs",
    "test": "node --test",
    "build": "node ../scripts/mcp-bundle.mjs",
    "prepack": "npm run build"
  },
  "overrides": {
    "@ethersproject/providers": {
      "ws": "7.5.11"
    },
    "@ethersproject/bignumber": {
      "bn.js": "5.2.3"
    },
    "@ethersproject/signing-key": {
      "bn.js": "5.2.3",
      "elliptic": {
        ".": "6.6.1",
        "bn.js": "4.12.3"
      }
    },
    "elliptic": {
      "bn.js": "4.12.3"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AgalmicSoftware/context-engine",
    "directory": "mcp"
  },
  "homepage": "https://github.com/AgalmicSoftware/context-engine/tree/main/mcp#readme",
  "bugs": {
    "url": "https://github.com/AgalmicSoftware/context-engine/issues"
  },
  "keywords": [
    "context-engine",
    "mcp",
    "agents",
    "deliberation"
  ],
  "devDependencies": {
    "ethers": "5.7.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
